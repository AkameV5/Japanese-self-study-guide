<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/pinkBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Упражнение завершено! 🎉"
        android:textSize="24sp"
        android:textColor="@color/accentPink"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Правильных ответов: 0 из 0\nРезультат: 0%"
        android:textSize="20sp"
        android:textColor="@color/textDark"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/learnedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Изучено символов: 0 из 0"
        android:textSize="18sp"
        android:textColor="@color/textDark"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnBackToList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вернуться к списку"
        android:textSize="16sp"
        android:padding="16dp"
        android:backgroundTint="@color/accentPink"/>

</LinearLayout>